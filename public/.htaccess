Options -Indexes
RewriteEngine On
RewriteRule ^\.lumina-data(?:/|$) - [F,L,NC]
RewriteRule ^(?:lumina-security|lumina-media)\.php$ - [F,L,NC]
RewriteRule ^portafolios/[a-z0-9-]+/[a-z0-9-]+/?$ index.html [L]
<IfModule mod_headers.c>
  <Files "index.html">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>
